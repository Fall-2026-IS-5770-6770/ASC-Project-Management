// Database schema for the ASC project management app.
// After changing it, run:  npx prisma migrate dev --name <what-changed>
// Each model's audit column holds who created and last changed the record.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Task statuses: the columns on a project workspace's board (Issue #40)
model Status {
  id              Int             @id @default(autoincrement())
  name            String
  description     String
  order           Int?
  audit           Json?
  projectStatuses ProjectStatus[]
}

// Columns on the main board that every project appears on (Issue #42)
model MainBoardStatus {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  order       Int?
  audit       Json?

  projects Project[]
}

// Everyone involved with ASC projects: students, mentors, managers, and staff (Issue #43)
model Person {
  id        Int     @id @default(autoincrement())
  firstName String
  lastName  String
  email     String  @unique
  phone     String?
  address   Json?
  audit     Json?

  managedProjects Project[]       @relation("ProjectManager")
  mentor          Mentor?
  student         Student?
  projectPeople   ProjectPerson[]
  personSkills    PersonSkill[]
  documents       Document[]
  channels        Channel[]       @relation("ChannelParticipants")
  threads         Thread[]
  messages        Message[]
}

// Areas of knowledge or expertise (Issue #47)
model Skill {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  category    String
  description String?
  audit       Json?

  projectTypes  ProjectType[]  @relation("ProjectTypeSkills")
  mentors       Mentor[]       @relation("MentorSkills")
  students      Student[]      @relation("StudentSkills")
  projectSkills ProjectSkill[]
  personSkills  PersonSkill[]
}

// Kinds of work a project can involve, such as Full-Stack or Data Visualization (Issue #50)
model ProjectType {
  id                   Int                  @id @default(autoincrement())
  name                 String               @unique
  description          String?
  typicalDurationWeeks Int?
  typicalDeliverables  String[]
  typicalSkills        Skill[]              @relation("ProjectTypeSkills")
  audit                Json?
  preferredByMentors   Mentor[]             @relation("MentorPreferredType")
  preferredByStudents  Student[]            @relation("StudentPreferredType")
  projectProjectTypes  ProjectProjectType[]
}

// Organizations and individuals who request projects: profit, non-profit, or internal (Issue #52)
model Client {
  id                Int     @id @default(autoincrement())
  name              String  @unique
  type              String
  contactPersonName String?
  contactEmail      String?
  phone             String?
  address           Json?
  billingEmail      String?
  billingTerms      String?
  audit             Json?

  projects Project[]
}

// The central record: a card on the main board, with its workspace, team,
// tasks, channels, and documents hanging off it (Issue #39)
model Project {
  id                     Int                  @id @default(autoincrement())
  name                   String
  description            String?
  clientId               Int
  client                 Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  mainBoardStatusId      Int
  mainBoardStatus        MainBoardStatus      @relation(fields: [mainBoardStatusId], references: [id], onDelete: Restrict)
  projectManagerId       Int?
  projectManager         Person?              @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: Restrict)
  startDate              DateTime?            @db.Date
  midpointDate           DateTime?            @db.Date
  endDate                DateTime?            @db.Date
  budget                 Decimal?             @db.Decimal(12, 2)
  estimatedHours         Float?
  notes                  String?
  // Set the first time the project moves into In Progress and its workspace is created
  workspaceInitializedAt DateTime?
  audit                  Json?
  projectStatuses        ProjectStatus[]
  projectPeople          ProjectPerson[]
  projectSkills          ProjectSkill[]
  projectProjectTypes    ProjectProjectType[]
  documents              Document[]
  channels               Channel[]
}

// Faculty who oversee and advise projects. A mentor is a person plus these details (Issue #44)
model Mentor {
  id                     Int          @id @default(autoincrement())
  personId               Int          @unique
  person                 Person       @relation(fields: [personId], references: [id], onDelete: Restrict)
  department             String?
  availability           String?
  maxProjectLoad         Int?
  preferredProjectTypeId Int?
  preferredProjectType   ProjectType? @relation("MentorPreferredType", fields: [preferredProjectTypeId], references: [id], onDelete: Restrict)
  skills                 Skill[]      @relation("MentorSkills")
  audit                  Json?
}

// Team members who do the work on projects. A student is a person plus these details (Issue #45)
model Student {
  id                     Int          @id @default(autoincrement())
  personId               Int          @unique
  person                 Person       @relation(fields: [personId], references: [id], onDelete: Restrict)
  major                  String?
  graduationDate         DateTime?    @db.Date
  resumeUrl              String?
  minHoursPerWeek        Float?
  maxHoursPerWeek        Float?
  workApprovalStatus     String
  availability           String?
  preferredProjectTypeId Int?
  preferredProjectType   ProjectType? @relation("StudentPreferredType", fields: [preferredProjectTypeId], references: [id], onDelete: Restrict)
  skills                 Skill[]      @relation("StudentSkills")
  audit                  Json?
}

// Which statuses a project uses; in order, they are the columns on its board (Issue #41)
model ProjectStatus {
  id        Int     @id @default(autoincrement())
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  statusId  Int
  status    Status  @relation(fields: [statusId], references: [id], onDelete: Restrict)
  order     Int?
  audit     Json?

  // A project can't list the same status twice
  @@unique([projectId, statusId])
}

// Who is on which project and in what role. These rows decide who can reach a
// project's workspace (Issue #46)
model ProjectPerson {
  id             Int       @id @default(autoincrement())
  projectId      Int
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  personId       Int
  person         Person    @relation(fields: [personId], references: [id], onDelete: Restrict)
  // Project Manager, Faculty Mentor, Student, or Sponsor
  role           String
  startDate      DateTime? @db.Date
  endDate        DateTime? @db.Date
  assignedHours  Float?
  approvalStatus String?
  status         String?
  audit          Json?

  @@unique([projectId, personId, role])
}

// The skills a project needs, and how much (Issue #48)
model ProjectSkill {
  id                 Int     @id @default(autoincrement())
  projectId          Int
  project            Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skillId            Int
  skill              Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  // Required or Preferred
  importance         String
  minimumProficiency String?
  audit              Json?

  @@unique([projectId, skillId])
}

// The skills a person has, how well, and how recently (Issue #49)
model PersonSkill {
  id              Int       @id @default(autoincrement())
  personId        Int
  person          Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  skillId         Int
  skill           Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  proficiency     String
  yearsExperience Float?
  lastUsed        DateTime? @db.Date
  audit           Json?

  @@unique([personId, skillId])
}

// The kinds of work a project involves. At most one per project is primary;
// the app un-marks the others in the same transaction (Issue #51)
model ProjectProjectType {
  id            Int         @id @default(autoincrement())
  projectId     Int
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectTypeId Int
  projectType   ProjectType @relation(fields: [projectTypeId], references: [id], onDelete: Cascade)
  isPrimary     Boolean     @default(false)
  audit         Json?

  @@unique([projectId, projectTypeId])
}

// Files and materials that belong to a project. There's no real upload yet, so
// the file is a name and a URL (Issue #53)
model Document {
  id           Int       @id @default(autoincrement())
  name         String
  projectId    Int
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type         String
  fileName     String?
  fileUrl      String?
  // Who uploaded it
  personId     Int?
  person       Person?   @relation(fields: [personId], references: [id], onDelete: Restrict)
  uploadedDate DateTime? @db.Date
  version      String?
  status       String
  audit        Json?
}

// Slack-style spaces for a project's conversations. #general is created with the
// project's workspace; participants are who can use the channel (Issue #54)
model Channel {
  id           Int       @id @default(autoincrement())
  name         String
  projectId    Int
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Team, Client, Topic, or Archived
  type         String
  url          String?
  participants Person[]  @relation("ChannelParticipants")
  createdDate  DateTime? @db.Date
  audit        Json?
  threads      Thread[]
  messages     Message[]

  @@unique([projectId, name])
}

// A conversation inside a channel. The message count is counted from its
// messages rather than stored (Issue #55)
model Thread {
  id                Int       @id @default(autoincrement())
  channelId         Int
  channel           Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  name              String
  createdByPersonId Int?
  createdBy         Person?   @relation(fields: [createdByPersonId], references: [id], onDelete: Restrict)
  createdAt         DateTime?
  lastActivityAt    DateTime?
  audit             Json?
  messages          Message[]
}

// A message in a thread. The channel is kept on the row too, so messages can be
// read per channel without going through every thread (Issue #56)
model Message {
  id             Int       @id @default(autoincrement())
  threadId       Int
  thread         Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  channelId      Int
  channel        Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  senderPersonId Int
  sender         Person    @relation(fields: [senderPersonId], references: [id], onDelete: Restrict)
  body           String
  postedAt       DateTime?
  // Stays null until someone edits the message
  editedAt       DateTime?
  audit          Json?
}
