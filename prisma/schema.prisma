// Database schema for the ASC project management app.
// After changing it, run:  npx prisma migrate dev --name <what-changed>
// Each model's audit column holds who created and last changed the record.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Task statuses: the columns on a project workspace's board (Issue #40)
model Status {
  id          Int    @id @default(autoincrement())
  name        String
  description String
  order       Int?
  audit       Json?
}

// Columns on the main board that every project appears on (Issue #42)
model MainBoardStatus {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  order       Int?
  audit       Json?

  projects Project[]
}

// Everyone involved with ASC projects: students, mentors, managers, and staff (Issue #43)
model Person {
  id        Int     @id @default(autoincrement())
  firstName String
  lastName  String
  email     String  @unique
  phone     String?
  address   Json?
  audit     Json?

  managedProjects Project[] @relation("ProjectManager")
}

// Areas of knowledge or expertise (Issue #47)
model Skill {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  category    String
  description String?
  audit       Json?

  projectTypes ProjectType[] @relation("ProjectTypeSkills")
}

// Kinds of work a project can involve, such as Full-Stack or Data Visualization (Issue #50)
model ProjectType {
  id                   Int      @id @default(autoincrement())
  name                 String   @unique
  description          String?
  typicalDurationWeeks Int?
  typicalDeliverables  String[]
  typicalSkills        Skill[]  @relation("ProjectTypeSkills")
  audit                Json?
}

// Organizations and individuals who request projects: profit, non-profit, or internal (Issue #52)
model Client {
  id                Int     @id @default(autoincrement())
  name              String  @unique
  type              String
  contactPersonName String?
  contactEmail      String?
  phone             String?
  address           Json?
  billingEmail      String?
  billingTerms      String?
  audit             Json?

  projects Project[]
}

// The central record: a card on the main board, with its workspace, team,
// tasks, channels, and documents hanging off it (Issue #39)
model Project {
  id                     Int             @id @default(autoincrement())
  name                   String
  description            String?
  clientId               Int
  client                 Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  mainBoardStatusId      Int
  mainBoardStatus        MainBoardStatus @relation(fields: [mainBoardStatusId], references: [id], onDelete: Restrict)
  projectManagerId       Int?
  projectManager         Person?         @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: Restrict)
  startDate              DateTime?       @db.Date
  midpointDate           DateTime?       @db.Date
  endDate                DateTime?       @db.Date
  budget                 Decimal?        @db.Decimal(12, 2)
  estimatedHours         Float?
  notes                  String?
  // Set the first time the project moves into In Progress and its workspace is created
  workspaceInitializedAt DateTime?
  audit                  Json?
}
