# Copy this file to .env and adjust as needed. .env is not committed.

# PostgreSQL from docker-compose.yml (docker compose up -d), used through Prisma
DATABASE_URL="postgresql://asc:asc_dev_password@localhost:5433/asc?schema=public"

# Signs the session cookie. Use a long random value outside development.
SESSION_SECRET=

# Port the app listens on (default 3000)
PORT=3000
