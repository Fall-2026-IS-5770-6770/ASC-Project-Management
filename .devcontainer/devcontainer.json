// Open this repo in a dev container (VS Code "Reopen in Container", or GitHub
// Codespaces) and everything is ready: Node, PostgreSQL, and MongoDB, with the
// database migrated and the dummy data loaded. The app starts in a terminal
// and opens on port 3000. Sign in with the Microsoft stand-in as
// priya.raman@usu.edu (ASC Administrator), or pick anyone else from the list.
// Format details: https://aka.ms/devcontainer.json
{
	"name": "ASC Project Management",

	// The app's workspace container plus the Postgres and MongoDB services
	"dockerComposeFile": ["../docker-compose.yml", "docker-compose.yml"],
	"service": "workspace",
	"runServices": ["workspace", "postgres", "mongo"],
	"workspaceFolder": "/workspaces/ASC-Project-Management",
	"shutdownAction": "stopCompose",

	"forwardPorts": [3000],
	"portsAttributes": {
		"3000": { "label": "ASC app", "onAutoForward": "openBrowser" }
	},

	// Once, when the container is created: install (which generates the Prisma
	// client), apply migrations, and load the dummy data into an empty database.
	// node_modules is a volume that starts out owned by root, hence the chown.
	"postCreateCommand": "sudo chown node node_modules && npm install && npx prisma migrate deploy && node prisma/seed.js --if-empty",

	// Every time VS Code attaches: start the app with auto-reload
	"postAttachCommand": "npm run dev",

	"customizations": {
		"vscode": {
			"extensions": [
				"dbaeumer.vscode-eslint",
				"Prisma.prisma",
				"mongodb.mongodb-vscode"
			]
		}
	}
}
