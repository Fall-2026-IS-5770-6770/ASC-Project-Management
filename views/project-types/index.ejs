<%- include("./partials/header.ejs") %>

<h1 class="mt-4">Project Types</h1>

<button class="btn btn-primary mb-3" data-bs-toggle="modal" data-bs-target="#newTypeModal">
    New project type
</button>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Name</th>
            <th>Duration</th>
            <th>Deliverables</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        <% projectTypes.forEach((projectType) => { %>
            <tr>
                <td><a href="/project-types/<%= projectType.id %>"><%= projectType.name %></a></td>
                <td><%= projectType.typicalDurationWeeks %> weeks</td>
                <td><%= projectType.typicalDeliverables.join(", ") %></td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" href="/project-types/edit/<%= projectType.id %>">
                        <i class="bi bi-pencil"></i>
                    </a>
                    <form class="d-inline" action="/project-types/delete/<%= projectType.id %>" method="POST" onsubmit="return confirm('Delete this project type?')">
                        <button class="btn btn-sm btn-outline-danger" type="submit">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                </td>
            </tr>
        <% }) %>
    </tbody>
</table>

<div class="modal fade" id="newTypeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form class="modal-content" action="/project-types/new" method="POST">
            <div class="modal-header">
                <h5 class="modal-title">New project type</h5>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label" for="name">Name</label>
                    <input class="form-control" id="name" name="name" required />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="description">Description</label>
                    <textarea class="form-control" id="description" name="description" rows="3"></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="typicalDurationWeeks">Typical duration (weeks)</label>
                    <input class="form-control" id="typicalDurationWeeks" name="typicalDurationWeeks" type="number" />
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-primary" type="submit">Save</button>
            </div>
        </form>
    </div>
</div>

<%- include("./partials/footer") %>