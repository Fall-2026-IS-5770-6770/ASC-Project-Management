<%- include('components/header'); %>
        <div class="card mb-4">
            <div class="card-header">
                <i class="bi bi-pencil-fill me-1"></i>
                Editing Project Status <%=projectStatus.id%>...
            </div>
            <div class="card-body">
                <form action="/project-status/edit/<%=projectStatus.id%>" method="post" id="editProjectStatusForm">
                    <div class="mb-3">
                        <label for="projectid" class="form-label">Project</label>
                        <select class="form-select" aria-label="Project" id="projectid" name="projectid">
                        <option selected value=<%=projectStatus.projectId%>><%=projectStatus.project.name%></option>
                        <% for (let project of projects) {%>
                        <option value=<%=project.id%>><%=project.name%></option>
                        <%}%>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="statusid" class="form-label">Status</label>
                        <select class="form-select" aria-label="Status" id="statusid" name="statusid">
                        <option selected value=<%=projectStatus.statusId%>><%=projectStatus.status.name%></option>
                        <% for (let status of statuses) {%>
                        <option value=<%=status.id%>><%=status.name%></option>
                        <%}%>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="order" class="form-label">Order</label>
                        <input type="number" class="form-control" id="order" name="order" max="20" min="1" value="<%=projectStatus.order%>">
                    </div>
                </form>
            </div>
            <div class="card-footer">
                <button type="submit" form="editProjectStatusForm" class="btn btn-primary">
                    <i class="bi bi-floppy"></i>&nbsp;&nbsp;Save
                </button>
            </div>
        </div>
    </div>
</main>
<%- include('components/footer'); %>
