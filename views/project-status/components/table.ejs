<table id="datatablesSimple">
    <thead>
        <tr>
            <th>Project</th>
            <th>Status</th>
            <th>Order</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tfoot>
        <tr>
            <th>Project</th>
            <th>Status</th>
            <th>Order</th>
            <th>Actions</th>
        </tr>
    </tfoot>
    <tbody>
        <% for (let projectStatus of projectStatuses) {%>
            <tr>
                <td><%=projectStatus.project.name%></td>
                <td><%=projectStatus.status.name%></td>
                <td><%=projectStatus.order%></td>
                <td>
                    <a href="/project-status/<%=projectStatus.id%>" type="button" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-eye"></i>
                    </a>
                    <a href="/project-status/edit/<%=projectStatus.id%>" type="button" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-pencil"></i>
                    </a>
                    <button
                        type="button"
                        class="btn btn-outline-danger btn-sm" data-bs-toggle="modal"
                        data-bs-target="#deleteModal"
                        data-bs-itemid="<%=projectStatus.id%>"
                        data-bs-project="<%=projectStatus.project.name%>"
                        data-bs-status="<%=projectStatus.status.name%>"
                    >
                        <i class="bi bi-trash3"></i>
                    </button>
                </td>
            </tr>
        <%}%>
    </tbody>
</table>
