<!DOCTYPE html>
<html lang="en">
    <%- include('../partials/head') %>
    <body>
        <div class="d-flex" id="wrapper">
            <%- include('../partials/sidebar') %>
            <!-- Page content wrapper-->
            <div id="page-content-wrapper">
                <%- include('../partials/topNav') %>
                <!-- Page content-->
                <div class="container-fluid">
                    <div class="d-flex align-items-center justify-content-between mt-4 mb-3">
                        <h1 class="mb-0">Main Board</h1>
                        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newProjectModal">
                            <i class="bi bi-plus-lg"></i> New project
                        </button>
                    </div>

                    <!-- One column per main board status, each holding its project cards -->
                    <div class="d-flex gap-3 overflow-auto pb-3">
                        <% columns.forEach(({ status, projects }) => { %>
                            <div class="bg-light border rounded p-2" style="flex: 0 0 17rem;">
                                <div class="d-flex justify-content-between align-items-center px-1 mb-2">
                                    <h2 class="h6 mb-0" title="<%= status.description %>"><%= status.name %></h2>
                                    <span class="badge bg-secondary"><%= projects.length %></span>
                                </div>
                                <% projects.forEach((project) => { %>
                                    <div class="card mb-2 shadow-sm">
                                        <div class="card-body p-2">
                                            <h3 class="h6 card-title mb-1">
                                                <a href="/projects/<%= project.id %>"><%= project.name %></a>
                                            </h3>
                                            <p class="small text-muted mb-1"><%= project.clientName %></p>
                                            <p class="small mb-2"><i class="bi bi-person"></i> <%= project.managerName %></p>
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span class="small text-muted"><%= project.endDate %></span>
                                                <div>
                                                    <a class="btn btn-sm btn-outline-secondary" href="/projects/edit/<%= project.id %>" aria-label="Edit project">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>
                                                    <form class="d-inline" action="/projects/delete/<%= project.id %>" method="POST" onsubmit="return confirm('Delete this project?')">
                                                        <button class="btn btn-sm btn-outline-danger" type="submit" aria-label="Delete project">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                <% }) %>
                                <% if (projects.length === 0) { %>
                                    <p class="small text-muted text-center my-3">No projects</p>
                                <% } %>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>
        </div>

        <!-- Create project modal -->
        <div class="modal fade" id="newProjectModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <form class="modal-content" action="/projects/new" method="POST">
                    <div class="modal-header">
                        <h5 class="modal-title">New project</h5>
                        <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <%- include('components/projectFields', { project: {}, includeStatus: true }) %>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                        <button class="btn btn-primary" type="submit">Save</button>
                    </div>
                </form>
            </div>
        </div>

        <%- include('../partials/scripts') %>
    </body>
</html>
