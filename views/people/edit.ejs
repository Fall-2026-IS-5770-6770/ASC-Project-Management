<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit person</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 40px; }
    dialog { border: 1px solid #ccc; border-radius: 8px; padding: 24px; width: min(400px, 90%); }
    label { display: block; margin-top: 14px; }
    input { box-sizing: border-box; width: 100%; padding: 8px; margin-top: 4px; }
    .actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px; }
  </style>
</head>
<body>
  <a href="/people">← Back to people</a>

  <dialog id="edit-dialog">
    <h1>Edit person</h1>

    <form action="/people/edit/<%= person.id %>" method="POST">
      <label for="firstName">First name</label>
      <input id="firstName" name="firstName"
             value="<%= person.firstName %>" required>

      <label for="lastName">Last name</label>
      <input id="lastName" name="lastName"
             value="<%= person.lastName %>" required>

      <label for="email">Email</label>
      <input id="email" name="email" type="email"
             value="<%= person.email %>" required>

      <div class="actions">
        <a href="/people">Cancel</a>
        <button type="submit">Submit edit</button>
      </div>
    </form>
  </dialog>

  <dialog id="confirmation-dialog">
    <h1>Edit submitted</h1>
    <p>The information was sent to the edit route.</p>
    <a href="/people">Back to people</a>
  </dialog>

  <script>
    <% if (submitted) { %>
      document.getElementById("confirmation-dialog").showModal();
    <% } else { %>
      document.getElementById("edit-dialog").showModal();
    <% } %>
  </script>
</body>
</html>