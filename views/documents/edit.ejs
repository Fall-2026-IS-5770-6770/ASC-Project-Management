<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Document</title>
</head>

<body>

    <h1>Edit Document</h1>

    <form action="/documents/edit/<%= document.id %>" method="POST">

        <label for="name">Document Name</label>
        <input id="name" name="name"
               value="<%= document.name %>" required>

        <br><br>

        <label for="type">Type</label>
        <input id="type" name="type"
               value="<%= document.type %>" required>

        <br><br>

        <label for="fileName">File Name</label>
        <input id="fileName" name="fileName"
               value="<%= document.fileName %>" required>

        <br><br>

        <label for="fileUrl">File URL</label>
        <input id="fileUrl" name="fileUrl"
               value="<%= document.fileUrl %>" required>

        <br><br>

        <label for="projectId">Project</label>
        <select id="projectId" name="projectId">

            <% projects.forEach(project => { %>
                <option value="<%= project.id %>"
                    <%= project.id === document.projectId ? "selected" : "" %>>
                    <%= project.name %>
                </option>
            <% }) %>

        </select>

        <br><br>

        <label for="personId">Uploaded By</label>
        <select id="personId" name="personId">

            <% people.forEach(person => { %>
                <option value="<%= person.id %>"
                    <%= person.id === document.personId ? "selected" : "" %>>
                    <%= person.firstName %> <%= person.lastName %>
                </option>
            <% }) %>

        </select>

        <br><br>

        <label for="uploadedDate">Uploaded Date</label>
        <input id="uploadedDate" name="uploadedDate" type="date"
               value="<%= document.uploadedDate %>">

        <br><br>

        <label for="version">Version</label>
        <input id="version" name="version"
               value="<%= document.version %>">

        <br><br>

        <label for="status">Status</label>
        <input id="status" name="status"
               value="<%= document.status %>">

        <br><br>

        <button type="submit">Save Changes</button>

    </form>

    <p>
        <a href="/documents">Cancel</a>
    </p>

</body>

</html>