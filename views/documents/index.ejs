<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Documents</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 40px;
            background-color: #f5f5f5;
        }

        .container {
            max-width: 1200px;
            margin: auto;
            background: white;
            padding: 30px;
            border-radius: 8px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 25px;
        }

        th,
        td {
            border-bottom: 1px solid #ddd;
            padding: 12px;
            text-align: left;
        }

        th {
            background-color: #f0f0f0;
        }

        button,
        .button {
            padding: 8px 12px;
            cursor: pointer;
            text-decoration: none;
        }

        .actions {
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .actions form {
            margin: 0;
        }

        dialog {
            width: 500px;
            border: none;
            border-radius: 8px;
            padding: 25px;
        }

        dialog::backdrop {
            background: rgba(0, 0, 0, 0.5);
        }

        label {
            display: block;
            margin-top: 12px;
        }

        input,
        select {
            width: 100%;
            padding: 8px;
            margin-top: 4px;
            box-sizing: border-box;
        }

        .modal-buttons {
            margin-top: 20px;
            display: flex;
            gap: 10px;
        }
    </style>
</head>

<body>

    <div class="container">

        <div class="header">
            <div>
                <h1>Documents</h1>
                <p>Manage project documents and reference materials.</p>
            </div>

            <button type="button"
                    onclick="document.getElementById('createDocument').showModal()">
                + New Document
            </button>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Document</th>
                    <th>Project</th>
                    <th>Version</th>
                    <th>Status</th>
                    <th>Uploaded By</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                <% documents.forEach(document => { %>

                    <tr>
                        <td>
                            <a href="/documents/<%= document.id %>">
                                <%= document.name %>
                            </a>
                        </td>

                        <td><%= document.projectName %></td>
                        <td>v<%= document.version %></td>
                        <td><%= document.status %></td>
                        <td><%= document.uploaderName %></td>

                        <td class="actions">

                            <a class="button"
                               href="/documents/edit/<%= document.id %>"
                               title="Edit">
                                ✏️
                            </a>

                            <form action="/documents/delete/<%= document.id %>"
                                  method="POST"
                                  onsubmit="return confirm('Are you sure you want to delete this document?');">

                                <button type="submit" title="Delete">
                                    🗑️
                                </button>

                            </form>

                        </td>
                    </tr>

                <% }) %>
            </tbody>
        </table>

    </div>

    <dialog id="createDocument">

        <h2>Create Document</h2>

        <form action="/documents/new" method="POST">

            <label for="name">Document Name</label>
            <input id="name" name="name" required>

            <label for="type">Type</label>
            <input id="type" name="type" required>

            <label for="fileName">File Name</label>
            <input id="fileName" name="fileName" required>

            <label for="fileUrl">File URL</label>
            <input id="fileUrl" name="fileUrl" required>

            <label for="projectId">Project</label>
            <select id="projectId" name="projectId" required>
                <% projects.forEach(project => { %>
                    <option value="<%= project.id %>">
                        <%= project.name %>
                    </option>
                <% }) %>
            </select>

            <label for="personId">Uploaded By</label>
            <select id="personId" name="personId" required>
                <% people.forEach(person => { %>
                    <option value="<%= person.id %>">
                        <%= person.firstName %> <%= person.lastName %>
                    </option>
                <% }) %>
            </select>

            <label for="uploadedDate">Uploaded Date</label>
            <input id="uploadedDate" name="uploadedDate" type="date" required>

            <label for="version">Version</label>
            <input id="version" name="version" required>

            <label for="status">Status</label>
            <input id="status" name="status" required>

            <div class="modal-buttons">
                <button type="submit">Add Document</button>

                <button type="button"
                        onclick="document.getElementById('createDocument').close()">
                    Cancel
                </button>
            </div>

        </form>

    </dialog>

</body>

</html>