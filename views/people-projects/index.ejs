<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Project Person Associations</title>
<link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="page">

  <div class="toolbar">
    <div>
      <h1>Project Person Associations</h1>
      <p class="sub">All project/person relationships</p>
    </div>
    <!--
      This button just opens the modal below.
      In your EJS this stays exactly as-is — no *% %> needed here.
    -->
    <button class="btn" data-open-modal="add-association-modal">+ Add Association</button>
  </div>

  <table>
    <tr>
      <th>Person</th>
      <th>Project</th>
      <th>Role</th>
      <th>Status</th>
      <th></th>
    </tr>

    <!--
      ROW BELOW IS ONE STATIC EXAMPLE ROW.
      In your EJS view, this <tr> is what you loop with *% rows.forEach(row => { %> ... *% }) %>
      Everywhere you see plain text here (project name, person name, role) becomes *%= %>
    -->
    <% rows.forEach(row => { %>
      <% const person = people.find((ps) => ps.id === row.personId);%> 
      <% const project = projects.find((pr) => pr.id === row.projectId);%>
      <tr>
        <td><%=person.firstName%> <%=person.LastName%></td>
        <td><%=project.name%></td>
        <td><%=row.role%></td>
        <td><span class="badge active"><%=row.status%></span></td>
        <td>
          <a href="/projects/people/<%=row.id%>">View</a>
          <!-- pencil = plain link styled as an icon, NOT a form -->
          <a class="icon edit" href="/projects/people/<%=row.id%>/edit">✏️</a>

          <!-- trash = its own tiny form, intercepted by main.js before it submits -->
          <form action="/projects/people/<%=row.id%>/delete" method="POST" class="delete-form" style="display:inline;">
            <button type="submit" class="icon del">🗑️</button>
          </form>
        </td>
    </tr>
    <% }) %> 
  </table>

  <!--
    ADD-ASSOCIATION MODAL
    Hidden by default via .modal-overlay in style.css, opened by main.js.
    The two <select> dropdowns are the parts that actually need EJS —
    everything else in this modal is static markup.
  -->
  <div class="modal-overlay" id="add-association-modal">
    <div class="modal">
      <h2>Add Association</h2>
      <form action="/projects/people" method="POST">

        <div class="form-group">
          <label for="projectId">Project</label>
          <select name="projectId" id="projectId">
            <% projects.forEach(p => { %>
              <option value="<%= p.id %>"><%= p.name %></option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label for="personId">Person</label>
          <select name="personId" id="personId">
            <% people.forEach(p => { %>
              <option value="<%= p.id %>"><%= p.firstName %> <%= p.lastName %></option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label for="role">Role</label>
          <input type="text" name="role" id="role" placeholder="e.g. Student">
        </div>

        <div class="modal-actions">
          <button type="button" class="btn btn-secondary" data-close-modal>Cancel</button>
          <button type="submit" class="btn">Add</button>
        </div>

      </form>
    </div>
  </div>

</div>

<script src="/js/main.js"></script>
</body>
</html>
