<!DOCTYPE html>
<html lang="en">
    <%- include('../partials/head') %>
    <body>
        <div class="d-flex" id="wrapper">
            <%- include('../partials/sidebar') %>
            <!-- Page content wrapper-->
            <div id="page-content-wrapper">
                <%- include('../partials/topNav') %>
                <!-- Page content-->
                <div class="container-fluid">
                    <a href="/students/<%= student.id %>" class="d-inline-block mt-3"><i class="bi bi-arrow-left"></i> Back to student</a>
                    <h1 class="mt-2">Edit <%= student.person.firstName %> <%= student.person.lastName %></h1>
                    <p class="text-muted">Name and contact info belong to the person record and are edited on the People pages.</p>

                    <form action="/students/edit/<%= student.id %>" method="POST" class="mb-4" style="max-width: 900px;">
                        <%- include('components/studentFields', { student }) %>
                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary">Save Changes</button>
                            <a href="/students/<%= student.id %>" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <%- include('../partials/scripts') %>
    </body>
</html>
