<!DOCTYPE html>
<html lang="en">
    <%- include('../partials/head') %>
    <body>
        <div class="d-flex" id="wrapper">
            <%- include('../partials/sidebar') %>
            <!-- Page content wrapper-->
            <div id="page-content-wrapper">
                <%- include('../partials/topNav') %>
                <!-- Page content-->
                <div class="container-fluid">
                    <div class="d-flex justify-content-between align-items-center mt-4 mb-3">
                        <h1 class="mb-0">Students</h1>
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createStudentModal">
                            <i class="bi bi-plus-lg"></i> Add Student
                        </button>
                    </div>

                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Major</th>
                                <th>Work Approval</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% students.forEach((student) => { %>
                                <tr>
                                    <td><a href="/students/<%= student.id %>"><%= student.person.firstName %> <%= student.person.lastName %></a></td>
                                    <td><%= student.major %></td>
                                    <td><%= student.workApprovalStatus %></td>
                                    <td class="text-end">
                                        <%- include('components/editButton', { student }) %>
                                        <%- include('components/deleteButton', { student }) %>
                                    </td>
                                </tr>
                            <% }) %>
                            <% if (students.length === 0) { %>
                                <tr><td colspan="4" class="text-muted">No students yet.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <%- include('components/createModal') %>
        <%- include('../partials/scripts') %>
        <% if (locals.openCreateModal) { %>
            <script>
                // Opened from /students/new, so show the create form right away
                window.addEventListener("DOMContentLoaded", () => {
                    new bootstrap.Modal(document.getElementById("createStudentModal")).show();
                });
            </script>
        <% } %>
    </body>
</html>
