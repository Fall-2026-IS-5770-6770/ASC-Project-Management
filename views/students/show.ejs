<!DOCTYPE html>
<html lang="en">
    <%- include('../partials/head') %>
    <body>
        <div class="d-flex" id="wrapper">
            <%- include('../partials/sidebar') %>
            <!-- Page content wrapper-->
            <div id="page-content-wrapper">
                <%- include('../partials/topNav') %>
                <!-- Page content-->
                <div class="container-fluid">
                    <a href="/students" class="d-inline-block mt-3"><i class="bi bi-arrow-left"></i> All students</a>
                    <div class="d-flex justify-content-between align-items-center mt-2 mb-3">
                        <h1 class="mb-0"><%= student.person.firstName %> <%= student.person.lastName %></h1>
                        <div>
                            <%- include('components/editButton', { student }) %>
                            <%- include('components/deleteButton', { student }) %>
                        </div>
                    </div>

                    <dl class="row">
                        <dt class="col-sm-3">Email</dt>
                        <dd class="col-sm-9"><%= student.person.email %></dd>
                        <dt class="col-sm-3">Phone</dt>
                        <dd class="col-sm-9"><%= student.person.phone %></dd>
                        <dt class="col-sm-3">Major</dt>
                        <dd class="col-sm-9"><%= student.major %></dd>
                        <dt class="col-sm-3">Graduation Date</dt>
                        <dd class="col-sm-9"><%= student.graduationDate %></dd>
                        <dt class="col-sm-3">Hours per Week</dt>
                        <dd class="col-sm-9"><%= student.minHoursPerWeek %> to <%= student.maxHoursPerWeek %></dd>
                        <dt class="col-sm-3">Work Approval</dt>
                        <dd class="col-sm-9"><%= student.workApprovalStatus %></dd>
                        <dt class="col-sm-3">Availability</dt>
                        <dd class="col-sm-9"><%= student.availability || 'Not provided' %></dd>
                        <dt class="col-sm-3">Preferred Project Type</dt>
                        <dd class="col-sm-9"><%= preferredProjectType ? preferredProjectType.name : 'No preference' %></dd>
                        <dt class="col-sm-3">Skills</dt>
                        <dd class="col-sm-9"><%= studentSkills.length ? studentSkills.map((skill) => skill.name).join(', ') : 'None listed' %></dd>
                        <dt class="col-sm-3">Resume</dt>
                        <dd class="col-sm-9"><%= student.resumeUrl || 'Not provided' %></dd>
                    </dl>
                </div>
            </div>
        </div>
        <%- include('../partials/scripts') %>
    </body>
</html>
