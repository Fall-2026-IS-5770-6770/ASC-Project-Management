<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Project</th>
            <th>Skill</th>
            <th>Importance</th>
            <th>Min. Proficiency</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        <% projectSkills.forEach(function(ps) { %>
            <tr>
                <td><%= ps.projectName %></td>
                <td><%= ps.skillName %></td>
                <td><%= ps.importance %></td>
                <td><%= ps.minimumProficiency %></td>
                <td>
                    <!-- Edit Button -->
                    <a href="/project-skills/<%= ps.id %>/edit" class="btn btn-sm btn-outline-secondary" title="Edit">
                        <i class="bi bi-pencil"></i>
                    </a>
                    <!-- Delete Button (Form) -->
                    <form action="/project-skills/<%= ps.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this skill requirement?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                </td>
            </tr>
        <% }); %>
    </tbody>
</table>